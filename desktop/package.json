{
  "name": "meetiny-desktop",
  "version": "1.0.0",
  "description": "Meetiny 데스크톱 앱 (Electron)",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "http-proxy": "^1.18.1"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.meetiny.desktop",
    "productName": "Meetiny",
    "files": [
      "main.js",
      "offline.html"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "app-dist"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    }
  }
}
